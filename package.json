{
  "name": "tymebox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A straightforward tool to optimize time in your meetings.",
  "author": "Guilherme Carvalho",
  "license": "MIT",
  "packageManager": "yarn@4.15.0",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode emulators",
    "dev:emulators": "firebase emulators:start --only auth,database --project demo-tymebox",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "knip": "knip",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "share-card": "node scripts/share-card.mjs",
    "rules": "python3 scripts/database-rules.py database.rules.json",
    "test:rules": "firebase emulators:exec --only auth,database --project demo-tymebox \"vitest run --config vitest.rules.config.ts\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\""
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "date-fns": "^4.4.0",
    "firebase": "^13.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-is": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.34.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.0.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "resolutions": {
    "websocket-driver": "0.7.5",
    "@grpc/grpc-js": "^1.13.6",
    "gaxios/uuid": "^11.1.1",
    "@google-cloud/pubsub/@opentelemetry/core": "^2.12.0"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
