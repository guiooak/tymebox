# `yarn dev:local` (vite --mode emulators) runs the app against the local
# Firebase emulators started by `yarn dev:emulators`. Nothing here is secret:
# "demo-" projects only exist in the emulator.
VITE_USE_EMULATORS=1
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000?ns=demo-tymebox-default-rtdb
VITE_FIREBASE_PROJECT_ID=demo-tymebox
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=demo-app
